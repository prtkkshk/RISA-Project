# Postgres connection string. On Supabase: Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# OpenAI key (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-...
# Optional: model with function calling. Default gpt-5-mini
OPENAI_MODEL=gpt-5-mini
